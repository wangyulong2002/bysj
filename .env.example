# ============================================================
# bysj 智慧校园 统一环境配置模板（入库版本）
#
# 用法：
#   cp .env.example .env        # 生成本地真实配置（.env 不入库）
#   make django / make fastapi  # Makefile 启动时自动 source .env
#   server 由 config.py 自动读取项目根 .env（FastAPI）
#   manage/（Django）读取同一 .env
#
# 注意：本文件需能被 sh source 解析，键值不允许行尾注释
#
# 数据库：campus 库（业务，FastAPI 与 Django 共享），
# 同一 MySQL 实例（WSL Docker，端口 3307）。
# ============================================================

# ===== 服务基础 =====
APP_NAME=智慧校园信息管理系统
APP_ENV=dev
DEBUG=true
API_PREFIX=/api

# ===== MySQL（WSL 内 Docker 容器，端口 3307）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASS=change-me
MYSQL_DB_CAMPUS=campus
MYSQL_DB_RY=ry
MYSQL_CHARSET=utf8mb4

# ===== Redis（缓存+向量+限流，Redis Stack 7+）=====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== JWT（FastAPI 应用端；轮换采用双密钥过渡，见设计 9.3 C-07）=====
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRE=7200
JWT_ALGORITHM=HS256

# ===== 微信小程序登录（B-01，T1-4 必需；联调可改 WECHAT_API_BASE_URL mock）=====
WECHAT_APPID=wx-xxx
WECHAT_SECRET=xxx
WECHAT_API_BASE_URL=https://api.weixin.qq.com

# ===== 登录限流（B-13：5 次/分钟/IP，与账号锁定 5 次/10 分钟双层防护）=====
LOGIN_RATE_PER_MIN=5

# ===== 火山引擎方舟（RAG，生成+向量化统一，按 Token 计费）=====
# 控制台申请 API Key: https://console.volcengine.com/ark
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=ark-xxx
LLM_MODEL=deepseek-chat
EMB_MODEL=doubao-embedding
EMB_DIM=2560
# ---- LLM 兜底通道（v2.7/ADR-013，可选：方舟失败时自动切换，仅生成兜底、Embedding 不兜底）----
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=sk-xxx
AGNES_MODEL=agnes-2.5-flash

# ===== RAG =====
RAG_TOP_N=5
RAG_KNN_K=10
RAG_RATE_PER_MIN=10
RAG_RATE_PER_DAY=100
RAG_LOG_RETENTION_DAYS=30
# 检索相关度三档阈值（v2.6/8.4.1：≥HIGH 正常；[LOW,HIGH) 低置信；<LOW 拒答，由 T7-7 标定）
RAG_SCORE_HIGH=0.75
RAG_SCORE_LOW=0.45
# 领域围栏开关（v2.6/8.4.1：1 启用 L0 规则闸门 + L2 领域围栏）
RAG_STRICT_DOMAIN=1
# 生成调用约束（8.4 注入防护第 5 层：限制输出 max_tokens / 8.6 P95≤4s）
LLM_TIMEOUT_SECONDS=10
LLM_MAX_TOKENS=1024

# ===== 文件 =====
FILE_UPLOAD_DIR=./uploads
FILE_MAX_SIZE_MB=10
FILE_ALLOWED_TYPES=jpg,png,gif,pdf,docx,xlsx

# ===== 备份 =====
BACKUP_DIR=/backup/mysql
BACKUP_RETENTION_DAYS=30

# ===== CORS（开发期 *，上线改白名单）=====
CORS_ALLOWED_ORIGINS=*

# ===== 登录安全 =====
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=10

# ===== 幂等（P1-12：MySQL 唯一表 campus_idempotency_key 为准，Redis 缓存 TTL=24h；登录不要求 Idempotency-Key）=====
IDEMPOTENCY_EXPIRE_SECONDS=86400

# ===== 对外地址（唯一地址源，一次部署全端通用）=====
# FastAPI 对外地址：签名 URL 直链（头像等）后端读取本值；
# 前端（H5/小程序/真机）由 make h5-build / make mp-build 自动注入同一地址；
# Django 管理端（manage/）读取本值推导 ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS / HTTPS 反代。
# 真机调试/部署：只改这里为局域网 IP 或域名（如 http://192.168.0.100:8000）→ 重新构建。
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ===== Django 管理端（部署：与 FastAPI 共享本 .env，见设计 9.3/9.4）=====
# 生产（DEBUG=false）必填；本地开发留空走内置默认密钥。
DJANGO_SECRET_KEY=
# ALLOWED_HOSTS：留空则自动从 PUBLIC_BASE_URL 推导 host（推荐，一次配置全端生效）；多域名逗号分隔。
DJANGO_ALLOWED_HOSTS=
# CSRF 信任来源：HTTPS 反代时留空则自动从 PUBLIC_BASE_URL 推导；特殊场景可逗号分隔覆盖。
DJANGO_CSRF_TRUSTED_ORIGINS=
# 管理端调试开关（可选，缺省跟随 DEBUG）。
DJANGO_DEBUG=
# Django 对外地址（预留：Django 端生成绝对 URL 时使用；缺省留空）。
DJANGO_BASE_URL=
