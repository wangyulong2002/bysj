# ============================================================
# bysj 智慧校园 统一环境配置模板（入库版本）
#
# 用法：
#   cp .env.example .env        # 生成本地真实配置（.env 不入库）
#   make ruoyi-admin            # Makefile 启动时自动 source .env（若依后端）
#   server 由 config.py 自动读取项目根 .env（FastAPI）
#
# 注意：本文件需能被 sh source 解析，键值不允许行尾注释
#
# 两组数据库：campus 库（FastAPI 业务）与 ry 库（若依后端），
# 同一 MySQL 实例（WSL Docker，端口 3307），仅库名不同。
# ============================================================

# ===== 服务基础 =====
APP_NAME=智慧校园信息管理系统
APP_ENV=dev
DEBUG=true
API_PREFIX=/api

# ===== MySQL（WSL 内 Docker 容器，端口 3307）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASS=change-me
MYSQL_DB_CAMPUS=campus
MYSQL_DB_RY=ry
MYSQL_CHARSET=utf8mb4

# ===== Redis（缓存+向量+限流，Redis Stack 7+）=====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== JWT（FastAPI；若依 JWT secret 在 application.yml 单独配置）=====
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRE=7200
JWT_ALGORITHM=HS256

# ===== 生成模型（DeepSeek，RAG）=====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# ===== Embedding（智谱 embedding-2，1024 维）=====
EMB_BASE_URL=https://open.bigmodel.cn
EMB_API_KEY=xxx
EMB_MODEL=embedding-2
EMB_DIM=1024

# ===== RAG =====
RAG_TOP_N=5
RAG_KNN_K=10
RAG_RATE_PER_MIN=10
RAG_RATE_PER_DAY=100
RAG_LOG_RETENTION_DAYS=30

# ===== 文件 =====
FILE_UPLOAD_DIR=./uploads
FILE_MAX_SIZE_MB=10
FILE_ALLOWED_TYPES=jpg,png,gif,pdf,docx,xlsx

# ===== 备份 =====
BACKUP_DIR=/backup/mysql
BACKUP_RETENTION_DAYS=30

# ===== CORS（开发期 *，上线改白名单）=====
CORS_ALLOWED_ORIGINS=*

# ===== 登录安全 =====
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=10
