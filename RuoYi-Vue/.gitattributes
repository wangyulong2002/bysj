# 统一换行符策略：文本文件入库统一为 LF，检出按平台自动转换
* text=auto

# 明确指定文本类型（若依为 Java/Vue/前端工程）
*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.properties text eol=lf
*.vue    text eol=lf
*.js     text eol=lf
*.ts     text eol=lf
*.json   text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.sh     text eol=lf
*.bat    text eol=crlf

# 二进制文件不转换
*.jar    binary
*.png    binary
*.jpg    binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary

# Maven 本地仓库（误跟踪历史遗留，绝不允许入库）
D:/Maven/**  text=false
/D:/Maven/** text=false
