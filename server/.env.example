# ===== 服务基础 =====
APP_NAME=智慧校园信息管理系统
APP_ENV=dev
DEBUG=true
API_PREFIX=/api

# ===== MySQL（唯一权威数据源）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=123456
MYSQL_DB=campus
MYSQL_CHARSET=utf8mb4

# ===== Redis（缓存+向量+限流，Redis Stack 7+）=====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== JWT =====
JWT_SECRET=please-change-me-to-a-random-secret
JWT_EXPIRE=7200
JWT_ALGORITHM=HS256

# ===== 生成模型（DeepSeek）=====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# ===== Embedding（智谱 embedding-2，1024 维）=====
EMB_BASE_URL=https://open.bigmodel.cn
EMB_API_KEY=xxx
EMB_MODEL=embedding-2
EMB_DIM=1024

# ===== RAG =====
RAG_TOP_N=5
RAG_KNN_K=10
RAG_RATE_PER_MIN=10
RAG_RATE_PER_DAY=100
RAG_LOG_RETENTION_DAYS=30

# ===== 文件 =====
FILE_UPLOAD_DIR=./uploads
FILE_MAX_SIZE_MB=10
FILE_ALLOWED_TYPES=jpg,png,gif,pdf,docx,xlsx

# ===== 备份 =====
BACKUP_DIR=/backup/mysql
BACKUP_RETENTION_DAYS=30

# ===== CORS（开发期 *，上线改白名单）=====
CORS_ALLOWED_ORIGINS=*

# ===== 登录安全 =====
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=10
