# ===== 服务基础 =====
APP_NAME=智慧校园信息管理系统
APP_ENV=dev
DEBUG=true
API_PREFIX=/api

# ===== MySQL（唯一权威数据源，WSL 内 Docker 容器，端口 3307）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASS=123456
MYSQL_DB=campus
MYSQL_CHARSET=utf8mb4

# ===== Redis（缓存+向量+限流，Redis Stack 7+）=====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== JWT =====
JWT_SECRET=please-change-me-to-a-random-secret
JWT_EXPIRE=7200
JWT_ALGORITHM=HS256

# ===== 微信小程序登录（B-01，T1-4 必需；联调可改 WECHAT_API_BASE_URL mock）=====
WECHAT_APPID=wx-xxx
WECHAT_SECRET=xxx
WECHAT_API_BASE_URL=https://api.weixin.qq.com

# ===== 登录限流（B-13：5 次/分钟/IP）=====
LOGIN_RATE_PER_MIN=5

# ===== 火山引擎方舟（RAG，生成+向量化统一，按 Token 计费）=====
# 控制台申请 API Key: https://console.volcengine.com/ark
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=ark-xxx
LLM_MODEL=deepseek-chat
EMB_MODEL=doubao-embedding
EMB_DIM=2560

# ===== RAG =====
RAG_TOP_N=5
RAG_KNN_K=10
RAG_RATE_PER_MIN=10
RAG_RATE_PER_DAY=100
RAG_LOG_RETENTION_DAYS=30

# ===== 文件 =====
FILE_UPLOAD_DIR=./uploads
FILE_MAX_SIZE_MB=10
FILE_ALLOWED_TYPES=jpg,png,gif,pdf,docx,xlsx

# ===== 备份 =====
BACKUP_DIR=/backup/mysql
BACKUP_RETENTION_DAYS=30

# ===== CORS（开发期 *，上线改白名单）=====
CORS_ALLOWED_ORIGINS=*

# ===== 登录安全 =====
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=10

# ===== 幂等（P1-12：MySQL 唯一表 campus_idempotency_key 为准，Redis 缓存 TTL=24h；登录不要求 Idempotency-Key）=====
IDEMPOTENCY_EXPIRE_SECONDS=86400
